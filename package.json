{
	"name": "local-iem-player",
	"version": "0.1.0",
	"private": true,
	"description": "Local-first, static, IEM-focused browser music player",
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"catalog:check": "vitest run src/catalog/generation.test.ts"
	},
	"dependencies": {
		"idb": "8.0.3",
		"music-metadata": "^11.15.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"fake-indexeddb": "6.2.5",
		"oxlint": "^1.82.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"vite": "^8.3.0",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^5.0.0",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1"
	}
}
